# ============================================================
# GENERAL
# ============================================================
DATABASE_URL=postgresql+asyncpg://travel_user:travel_pass@localhost:5432/travel_intelligence
SYNC_DATABASE_URL=postgresql://travel_user:travel_pass@localhost:5432/travel_intelligence

# ============================================================
# AUTH
# ============================================================
JWT_SECRET_KEY=change-this-to-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# CORS
# ============================================================
CORS_ORIGINS=http://localhost:3000,http://localhost

# ============================================================
# LLM PROVIDER
# ============================================================
# Options: gemini, openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# ============================================================
# EMBEDDING PROVIDER
# ============================================================
# Options: gemini, openai
EMBEDDING_PROVIDER=gemini
# Dimension must match the embedding model output:
#   Gemini text-embedding-004 → 768
#   OpenAI text-embedding-3-small → 1536
EMBEDDING_DIMENSION=768

# ============================================================
# MAPS
# ============================================================
MAPBOX_ACCESS_TOKEN=your-mapbox-access-token-here

# ============================================================
# WEATHER
# ============================================================
OPENWEATHER_API_KEY=your-openweather-api-key-here

# ============================================================
# APPLICATION
# ============================================================
ENVIRONMENT=development
APP_NAME=Travel Intelligence Platform
APP_VERSION=0.1.0
LOG_LEVEL=INFO
DEBUG=true

# ============================================================
# NEXT.JS FRONTEND (public variables)
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost/api/v1
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-access-token-here
NEXT_PUBLIC_APP_NAME=Travel Intelligence

# ============================================================
# POSTGRES (Docker Compose)
# ============================================================
POSTGRES_USER=travel_user
POSTGRES_PASSWORD=travel_pass
POSTGRES_DB=travel_intelligence
